<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Las lecturas de salud permanecen en el dispositivo y no entran en copias cloud. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PulsoCheck">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PulsoCheck"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Play Services inicia este servicio al llegar datos del reloj. -->
        <service
            android:name=".data.sync.HeartRateDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/pulsocheck/readings"
                    android:scheme="wear" />
            </intent-filter>
        </service>
        <!-- Recibe los resúmenes de episodios enviados por el reloj. -->
        <service
            android:name=".data.sync.HeartRateEpisodeDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/pulsocheck/episodes"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Recibe las respuestas que la persona registra en el reloj. -->
        <service
            android:name=".data.sync.EpisodeResponseDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/pulsocheck/responses"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
